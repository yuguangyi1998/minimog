{% doc %}
  @prompt
    生成一个16:9的banner 轮播图, 鼠标悬浮到左右切换按钮上 按钮中的icon颜色没有变化  还是黑色 需要变成白色了应该
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-banner-carousel-{{ ai_gen_id }} {
    position: relative;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    overflow: hidden;
    display: block;
  }

  .ai-banner-carousel__wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .ai-banner-carousel__slides-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.5s ease-in-out;
    height: 100%;
  }

  .ai-banner-carousel__slide-{{ ai_gen_id }} {
    min-width: 100%;
    height: 100%;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-banner-carousel__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-banner-carousel__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-banner-carousel__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-banner-carousel__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-banner-carousel__content-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    color: {{ block.settings.text_color }};
    width: 90%;
    max-width: 800px;
    z-index: 2;
  }

  .ai-banner-carousel__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    margin: 0 0 16px;
    font-weight: 600;
  }

  .ai-banner-carousel__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    margin: 0 0 24px;
    line-height: 1.6;
  }

  .ai-banner-carousel__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 12px 32px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    transition: all 0.3s ease;
  }

  .ai-banner-carousel__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
  }

  .ai-banner-carousel__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 1;
  }

  .ai-banner-carousel__nav-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: {{ block.settings.nav_bg_color }};
    color: {{ block.settings.nav_icon_color }};
    border: none;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 3;
    transition: all 0.3s ease;
    opacity: {{ block.settings.nav_opacity | divided_by: 100.0 }};
  }

  .ai-banner-carousel__nav-{{ ai_gen_id }}:hover {
    opacity: 1;
    background-color: {{ block.settings.nav_hover_bg_color }};
    color: {{ block.settings.nav_hover_icon_color }};
  }

  .ai-banner-carousel__nav--prev-{{ ai_gen_id }} {
    left: 20px;
  }

  .ai-banner-carousel__nav--next-{{ ai_gen_id }} {
    right: 20px;
  }

  .ai-banner-carousel__nav-{{ ai_gen_id }} svg {
    width: 24px;
    height: 24px;
  }

  .ai-banner-carousel__dots-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 8px;
    z-index: 3;
  }

  .ai-banner-carousel__dot-{{ ai_gen_id }} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    opacity: 0.5;
    cursor: pointer;
    border: none;
    padding: 0;
    transition: all 0.3s ease;
  }

  .ai-banner-carousel__dot-{{ ai_gen_id }}.active {
    opacity: 1;
    width: 30px;
    border-radius: 5px;
  }

  @media screen and (max-width: 749px) {
    .ai-banner-carousel__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.6 }}px;
    }

    .ai-banner-carousel__description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.8 }}px;
    }

    .ai-banner-carousel__button-{{ ai_gen_id }} {
      font-size: {{ block.settings.button_font_size | times: 0.9 }}px;
      padding: 10px 24px;
    }

    .ai-banner-carousel__nav-{{ ai_gen_id }} {
      width: 40px;
      height: 40px;
    }

    .ai-banner-carousel__nav--prev-{{ ai_gen_id }} {
      left: 10px;
    }

    .ai-banner-carousel__nav--next-{{ ai_gen_id }} {
      right: 10px;
    }
  }
{% endstyle %}

<banner-carousel-{{ ai_gen_id }}
  class="ai-banner-carousel-{{ ai_gen_id }}"
  data-autoplay="{{ block.settings.autoplay }}"
  data-autoplay-speed="{{ block.settings.autoplay_speed }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-banner-carousel__wrapper-{{ ai_gen_id }}">
    <div class="ai-banner-carousel__slides-{{ ai_gen_id }}">
      {% for i in (1..5) %}
        {% liquid
          assign image_key = 'slide_' | append: i | append: '_image'
          assign title_key = 'slide_' | append: i | append: '_title'
          assign description_key = 'slide_' | append: i | append: '_description'
          assign button_text_key = 'slide_' | append: i | append: '_button_text'
          assign button_link_key = 'slide_' | append: i | append: '_button_link'
          assign show_content_key = 'slide_' | append: i | append: '_show_content'

          assign slide_image = block.settings[image_key]
          assign slide_title = block.settings[title_key]
          assign slide_description = block.settings[description_key]
          assign slide_button_text = block.settings[button_text_key]
          assign slide_button_link = block.settings[button_link_key]
          assign show_content = block.settings[show_content_key]
        %}

        <div class="ai-banner-carousel__slide-{{ ai_gen_id }}" data-slide="{{ i }}">
          {% if slide_image %}
            <img
              src="{{ slide_image | image_url: width: 2000 }}"
              alt="{{ slide_image.alt | escape }}"
              loading="lazy"
              width="{{ slide_image.width }}"
              height="{{ slide_image.height }}"
              class="ai-banner-carousel__image-{{ ai_gen_id }}"
            >
          {% else %}
            <div class="ai-banner-carousel__placeholder-{{ ai_gen_id }}">
              {{ 'hero-apparel-1' | placeholder_svg_tag }}
              {% if i == 1 %}
                <div class="ai-banner-carousel__empty-state-{{ ai_gen_id }}">
                  添加轮播图片
                </div>
              {% endif %}
            </div>
          {% endif %}

          {% if block.settings.show_overlay %}
            <div class="ai-banner-carousel__overlay-{{ ai_gen_id }}"></div>
          {% endif %}

          {% if show_content %}
            <div class="ai-banner-carousel__content-{{ ai_gen_id }}">
              {% if slide_title != blank %}
                <h2 class="ai-banner-carousel__title-{{ ai_gen_id }}">{{ slide_title }}</h2>
              {% endif %}

              {% if slide_description != blank %}
                <div class="ai-banner-carousel__description-{{ ai_gen_id }}">{{ slide_description }}</div>
              {% endif %}

              {% if slide_button_text != blank and slide_button_link != blank %}
                <a
                  href="{{ slide_button_link }}"
                  class="ai-banner-carousel__button-{{ ai_gen_id }}"
                >
                  {{ slide_button_text }}
                </a>
              {% endif %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    {% if block.settings.show_navigation %}
      <button
        class="ai-banner-carousel__nav-{{ ai_gen_id }} ai-banner-carousel__nav--prev-{{ ai_gen_id }}"
        aria-label="上一张"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <button
        class="ai-banner-carousel__nav-{{ ai_gen_id }} ai-banner-carousel__nav--next-{{ ai_gen_id }}"
        aria-label="下一张"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    {% endif %}

    {% if block.settings.show_dots %}
      <div class="ai-banner-carousel__dots-{{ ai_gen_id }}">
        {% for i in (1..5) %}
          <button
            class="ai-banner-carousel__dot-{{ ai_gen_id }} {% if i == 1 %}active{% endif %}"
            data-slide="{{ i }}"
            aria-label="跳转到第 {{ i }} 张"
          ></button>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</banner-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class BannerCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.totalSlides = 5;
        this.autoplayInterval = null;
      }

      connectedCallback() {
        this.slidesContainer = this.querySelector('.ai-banner-carousel__slides-{{ ai_gen_id }}');
        this.prevButton = this.querySelector('.ai-banner-carousel__nav--prev-{{ ai_gen_id }}');
        this.nextButton = this.querySelector('.ai-banner-carousel__nav--next-{{ ai_gen_id }}');
        this.dots = this.querySelectorAll('.ai-banner-carousel__dot-{{ ai_gen_id }}');

        this.setupEventListeners();
        this.startAutoplay();
      }

      disconnectedCallback() {
        this.stopAutoplay();
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.goToPrevSlide());
        }

        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.goToNextSlide());
        }

        this.dots.forEach((dot, index) => {
          dot.addEventListener('click', () => this.goToSlide(index));
        });

        this.addEventListener('mouseenter', () => this.stopAutoplay());
        this.addEventListener('mouseleave', () => this.startAutoplay());
      }

      goToSlide(index) {
        this.currentSlide = index;
        this.updateSlidePosition();
        this.updateDots();
      }

      goToNextSlide() {
        this.currentSlide = (this.currentSlide + 1) % this.totalSlides;
        this.updateSlidePosition();
        this.updateDots();
      }

      goToPrevSlide() {
        this.currentSlide = (this.currentSlide - 1 + this.totalSlides) % this.totalSlides;
        this.updateSlidePosition();
        this.updateDots();
      }

      updateSlidePosition() {
        const offset = -this.currentSlide * 100;
        this.slidesContainer.style.transform = `translateX(${offset}%)`;
      }

      updateDots() {
        this.dots.forEach((dot, index) => {
          if (index === this.currentSlide) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }

      startAutoplay() {
        const autoplay = this.dataset.autoplay === 'true';
        const speed = parseInt(this.dataset.autoplaySpeed) || 5000;

        if (autoplay) {
          this.autoplayInterval = setInterval(() => {
            this.goToNextSlide();
          }, speed);
        }
      }

      stopAutoplay() {
        if (this.autoplayInterval) {
          clearInterval(this.autoplayInterval);
          this.autoplayInterval = null;
        }
      }
    }

    customElements.define('banner-carousel-{{ ai_gen_id }}', BannerCarousel{{ ai_gen_id }});
  })();
</script>

