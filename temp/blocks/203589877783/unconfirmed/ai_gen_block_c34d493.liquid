{% doc %}
  @prompt
    添加一个品牌故事板块
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-story-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin-inline: auto;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-story-{{ ai_gen_id }}__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(28px, 6vw, 88px);
    padding: clamp(32px, 6vw, 88px);
  }

  .ai-story-{{ ai_gen_id }}__media {
    overflow: hidden;
    background: #f5f5f5;
  }

  .ai-story-{{ ai_gen_id }}__media img,
  .ai-story-{{ ai_gen_id }}__media svg {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .ai-story-{{ ai_gen_id }}__copy {
    max-width: 560px;
  }

  .ai-story-{{ ai_gen_id }}__eyebrow {
    margin: 0 0 16px;
    color: {{ block.settings.accent_color }};
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .ai-story-{{ ai_gen_id }}__heading {
    margin: 0 0 22px;
    color: {{ block.settings.text_color }};
    font-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
    font-size: clamp(30px, 4vw, 52px);
    font-weight: 400;
    line-height: 1.12;
  }

  .ai-story-{{ ai_gen_id }}__body {
    font-size: 16px;
    line-height: 1.8;
  }

  .ai-story-{{ ai_gen_id }}__body p { margin: 0 0 16px; }
  .ai-story-{{ ai_gen_id }}__body p:last-child { margin-bottom: 0; }

  .ai-story-{{ ai_gen_id }}__link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 28px;
    padding: 0 0 7px;
    border-bottom: 1px solid {{ block.settings.accent_color }};
    color: {{ block.settings.accent_color }};
    text-decoration: none;
    font-weight: 600;
  }

  .ai-story-{{ ai_gen_id }}__link:focus-visible {
    outline: 2px solid {{ block.settings.accent_color }};
    outline-offset: 4px;
  }

  @media screen and (max-width: 749px) {
    .ai-story-{{ ai_gen_id }} { width: 100%; }
    .ai-story-{{ ai_gen_id }}__layout {
      grid-template-columns: 1fr;
      gap: 28px;
      padding: 28px 20px;
    }
    .ai-story-{{ ai_gen_id }}__media { order: 0; }
    .ai-story-{{ ai_gen_id }}__copy { order: 1; }
  }
{% endstyle %}

<div class="ai-story-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-story-{{ ai_gen_id }}__layout">
    <div class="ai-story-{{ ai_gen_id }}__media">
      {% if block.settings.story_image != blank %}
        <img src="{{ block.settings.story_image | image_url: width: 1400 }}" alt="{{ block.settings.story_image.alt | default: block.settings.heading | escape }}" loading="lazy" width="{{ block.settings.story_image.width }}" height="{{ block.settings.story_image.height }}">
      {% else %}
        <div class="ai-story-{{ ai_gen_id }}__placeholder">
          {{ 'image' | placeholder_svg_tag }}
          <p>Add an editorial image to bring your brand story to life.</p>
        </div>
      {% endif %}
    </div>
    <div class="ai-story-{{ ai_gen_id }}__copy">
      {% if block.settings.eyebrow != blank %}<p class="ai-story-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif %}
      {% if block.settings.heading != blank %}<h2 class="ai-story-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
      {% if block.settings.story_text != blank %}<div class="ai-story-{{ ai_gen_id }}__body">{{ block.settings.story_text }}</div>{% endif %}
      {% if block.settings.link_label != blank and block.settings.story_link != blank %}
        <a class="ai-story-{{ ai_gen_id }}__link" href="{{ block.settings.story_link }}">{{ block.settings.link_label | escape }} <span aria-hidden="true">→</span></a>
      {% endif %}
    </div>
  </div>
</div>

{% style %}
  .ai-story-{{ ai_gen_id }}__placeholder { position: relative; }
  .ai-story-{{ ai_gen_id }}__placeholder svg { background: #f5f5f5; color: #777; }
  .ai-story-{{ ai_gen_id }}__placeholder p {
    position: absolute;
    right: 16px;
    bottom: 16px;
    left: 16px;
    margin: 0;
    padding: 10px 14px;
    background: rgba(255,255,255,.94);
    color: #333;
    font-size: 13px;
    text-align: center;
  }
{% endstyle %}

{% schema %}
{
  "name": "Brand story",
  "settings": [
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "image_picker", "id": "story_image", "label": "Story image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Spaces shaped by considered living" },
    { "type": "richtext", "id": "story_text", "label": "Story", "default": "<p>We believe a home is built through thoughtful details, enduring materials and objects that feel personal. Discover the ideas and craft behind our collection.</p>" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Discover our story" },
    { "type": "url", "id": "story_link", "label": "Link" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#191919" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#6B1F32" }
  ],
  "presets": [{ "name": "Brand story" }],
  "tag": null,
  "class": "brand-story-block"
}
{% endschema %}