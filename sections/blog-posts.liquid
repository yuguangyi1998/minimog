{{ 'component-article-card.css' | asset_url | stylesheet_tag }}
{{ 'blog-post.css' | asset_url | stylesheet_tag }}
{% liquid
  assign blog_to_show = section.settings.limit | default: 3
  assign use_scroll_mobile = section.settings.use_scroll_mobile

  assign animation_effect = settings.animations
  assign animated = false
  if animation_effect != 'none'
    assign animated = true
    if section.settings.animations != 'inherit'
      assign animation_effect = section.settings.animations
    endif
  endif

  assign container = section.settings.container
  if container == 'w-full'
    assign container = 'container-full'
  endif

  assign blog = blogs[section.settings.blog]
  assign classes = 'm-section m-blog-grid'
  if section.settings.custom_class != blank
    assign classes = classes | append: ' ' | append: section.settings.custom_class
  endif
  assign classes = classes | append: ' m-gradient' | append: ' m-color-' | append: section.settings.color_scheme

  assign show_button_on_header = section.settings.show_button_on_header
%}
<style>
  #m-blog-grid-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --column-gap: {{ section.settings.column_gap }}px;
    --column-gap-mobile: {{ section.settings.mobile_gap }}px;
    --row-gap: {{ section.settings.column_gap | plus: 10 }}px;
  }
</style>
<section
  id="m-blog-grid-{{ section.id }}"
  class="{{ classes }}"
  data-section-id="{{ section.id }}"
>
  <div
    class="{{ container }} m-section-my m-section-py"
  >
    {% render 'index-section-header',
      section_settings: section.settings,
      show_button_on_header: show_button_on_header,
      button_style: section.settings.button_style,
      button_link: section.settings.button_link,
      button_size: section.settings.button_size,
      button_label: section.settings.button_text
    %}
    <div class="m-blog-grid__wrapper">
      <div class="m-mixed-layout{% if use_scroll_mobile %} m-mixed-layout--mobile-scroll{% endif %}">
        <div class="m-mixed-layout__inner m:grid md:m:grid-{{ section.settings.column | minus: 1 }}-cols lg:m:grid-{{ section.settings.column }}-cols">
          {% if blog.articles.size > 0 %}
            {% for article in blog.articles limit: section.settings.limit %}
              <div class="m:column">
                {% render 'article-card',
                  article: article,
                  view: 'grid',
                  settings: section.settings,
                  index: forloop.index,
                  animated: animated,
                  animation_effect: animation_effect
                %}
              </div>
            {% endfor %}
          {% else %}
            {% for i in (1..blog_to_show) %}
              <div class="m:column">
                {% render 'article-card-placeholder',
                  index: forloop.index,
                  animated: animated,
                  animation_effect: animation_effect
                %}
              </div>
            {% endfor %}
          {% endif %}
        </div>
      </div>
    </div>
    {% if section.settings.button_text != blank and show_button_on_header == false %}
      {% capture arrow %}<svg class="m-rlt-reverse-x" width="17" height="16" viewBox="0 0 17 16" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M7.03062 2.4694L12.0306 7.4694C12.1005 7.53908 12.156 7.62187 12.1939 7.71304C12.2317 7.8042 12.2512 7.90194 12.2512 8.00065C12.2512 8.09936 12.2317 8.1971 12.1939 8.28827C12.156 8.37943 12.1005 8.46222 12.0306 8.5319L7.03062 13.5319C6.88973 13.6728 6.69863 13.752 6.49937 13.752C6.30012 13.752 6.10902 13.6728 5.96812 13.5319C5.82723 13.391 5.74807 13.1999 5.74807 13.0007C5.74807 12.8014 5.82723 12.6103 5.96812 12.4694L10.4375 8.00003L5.9675 3.53065C5.8266 3.38976 5.74745 3.19866 5.74745 2.9994C5.74745 2.80015 5.8266 2.60905 5.9675 2.46815C6.10839 2.32726 6.29949 2.2481 6.49875 2.2481C6.69801 2.2481 6.8891 2.32726 7.03 2.46815L7.03062 2.4694Z" fill="currentColor"/>
        </svg>{% endcapture %}
      {% liquid
        assign is_button_icon = false
        if section.settings.button_text contains '[arrow]'
          assign is_button_icon = true
        endif
      %}
      <div class="m-blog-grid__button{% if animated %} m-scroll-trigger animate--{{ animation_effect }}{% endif %}">
        <a
          class="m-button{% if is_button_icon %} m-button--text-with-icon{% endif %} {{ section.settings.button_style | replace: 'sf__btn-primary', 'm-button--primary' | replace: 'sf__btn-secondary', 'm-button--secondary' | replace: 'sf__btn-link', 'm-button--link' | replace: 'sf__btn-white', 'm-button--white' }} {{ section.settings.button_size }}"
          href="{{ section.settings.button_link | default: '#' }}"
        >
          {{- section.settings.button_text | replace: '[arrow]', arrow -}}
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Blog posts 博客文章",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "[Watch tutorial](https://foxecom.link/4jFUGB)"
    },
    {
      "type": "header",
      "content": "Section header 标题"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading 标题",
      "default": "Blog posts"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size 标题大小",
      "default": "h3",
      "options": [
        {
          "label": "中等",
          "value": "h3"
        },
        {
          "label": "大",
          "value": "h2"
        }
      ]
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading 副标题"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description 描述"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Text alignment 文本对齐",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left 左对齐"
        },
        {
          "value": "center",
          "label": "Center 居中对齐"
        }
      ]
    },
    {
      "type": "header",
      "content": "General 通用"
    },
    {
      "type": "select",
      "id": "container",
      "label": "Container type 容器类型",
      "default": "container-fluid",
      "options": [
        {
          "value": "container-fluid",
          "label": "Default 默认"
        },
        {
          "value": "w-full",
          "label": "Full width 全宽"
        },
        {
          "value": "container",
          "label": "Use container box 使用容器框"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme 颜色方案"
    },
    {
      "type": "header",
      "content": "Content 内容"
    },
    {
      "id": "blog",
      "type": "blog",
      "label": "Blog 博客"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Posts to show 显示文章数量",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "column",
      "label": "Posts per row 每行显示文章数量",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap 列间距",
      "min": 0,
      "max": 50,
      "step": 2,
      "default": 30,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Column gap on mobile 移动设备列间距",
      "min": 0,
      "max": 30,
      "step": 2,
      "default": 10,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Card settings 卡片设置"
    },
    {
      "type": "select",
      "id": "article_image_aspect_ratio",
      "label": "Image aspect ratio 图片宽高比",
      "default": "16/9",
      "options": [
        {
          "value": "original",
          "label": "Original aspect ratio 原始宽高比"
        },
        {
          "value": "1/1",
          "label": "1:1"
        },
        {
          "value": "3/4",
          "label": "3:4"
        },
        {
          "value": "4/3",
          "label": "4:3"
        },
        {
          "value": "16/9",
          "label": "16:9"
        }
      ]
    },
    {
      "type": "select",
      "id": "article_align_content",
      "label": "Content alignment 内容对齐",
      "default": "text-left",
      "options": [
        {
          "label": "Left 左对齐",
          "value": "text-left"
        },
        {
          "label": "Center 居中对齐",
          "value": "text-center"
        },
        {
          "label": "Right 右对齐",
          "value": "text-right"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "article_show_tags",
      "label": "Show tags 显示标签",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "article_show_date",
      "label": "Show publised date 显示发布日期",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "article_show_excerpt",
      "label": "Show excerpt 显示摘要",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "article_show_button",
      "label": "Show read more link 显示阅读更多链接",
      "default": true
    },
    {
      "type": "header",
      "content": "Button settings 按钮设置"
    },
    {
      "type": "checkbox",
      "id": "show_button_on_header",
      "label": "Show button on header 显示按钮在标题"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link 按钮链接"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button label 按钮标签",
      "default": "View More",
      "info": "Leave it blank to hide"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style 按钮样式",
      "options": [
        {
          "value": "m-button--primary",
          "label": "Primary button 主要按钮"
        },
        {
          "value": "m-button--secondary",
          "label": "Secondary button 次要按钮"
        },
        {
          "value": "m-button--white",
          "label": "White button 白色按钮"
        },
        {
          "value": "m-button--link",
          "label": "Underline button 下划线按钮"
        },
        {
          "value": "m-button--plain",
          "label": "Plain button 普通按钮"
        }
      ],
      "default": "m-button--primary"
    },
    {
      "type": "select",
      "id": "button_size",
      "label": "Button size 按钮大小",
      "options": [
        {
          "value": "m-button--small",
          "label": "Button small 小按钮"
        },
        {
          "value": "",
          "label": "Button medium 中按钮"
        },
        {
          "value": "m-button--large",
          "label": "Button large 大按钮"
        }
      ],
      "default": ""
    },
    {
      "type": "header",
      "content": "Mobile Settings 移动设备设置"
    },
    {
      "type": "checkbox",
      "id": "use_scroll_mobile",
      "label": "Enable horizontal scroll 启用水平滚动",
      "default": true
    },
    {
      "type": "header",
      "content": "Section Padding 段落内边距"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top 上内边距",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom 下内边距",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Custom Attributes 自定义属性"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom classes 自定义类"
    },
    {
      "type": "header",
      "content": "Animations 动画"
    },
    {
      "type": "select",
      "id": "animations",
      "label": "Visible in the view animation 在视图中可见动画",
      "default": "inherit",
      "options": [
        {
          "value": "inherit",
          "label": "Inherit global setting 继承全局设置"
        },
        {
          "value": "fade-in",
          "label": "Fade in 淡入"
        },
        {
          "value": "fade-in-up",
          "label": "Fade in up 淡入上"
        },
        {
          "value": "fade-in-left",
          "label": "Fade in left 淡入左"
        },
        {
          "value": "fade-in-right",
          "label": "Fade in right 淡入右"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Blog posts 博客文章",
      "category": "Blog 博客"
    }
  ]
}
{% endschema %}
