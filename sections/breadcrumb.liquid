{% liquid
  assign container = section.settings.container
  assign class = ''
  if section.settings.hide_on_mb
    assign class = 'm:hidden md:m:block'
  endif

  assign animation_effect = settings.animations
  assign animated = false
  if animation_effect != 'none'
    assign animated = true
    if section.settings.animations != 'inherit'
      assign animation_effect = section.settings.animations
    endif
  endif
%}

{% render 'breadcrumb', 
  container: container, 
  justify: section.settings.text_alignment, 
  class: class, 
  hide_current: section.settings.hide_current,
  animated: animated, 
  animation_effect: animation_effect
%}
{% schema %}
{
  "name": "Breadcrumb 面包屑",
  "enabled_on": {
    "templates": [
      "product",
      "page",
      "collection"
    ]
  },
  "settings": [
    {
      "type": "select",
      "id": "container",
      "label": "Container type 容器类型",
      "default": "container",
      "options": [
        {
          "value": "container-fluid",
          "label": "Default 默认"
        },
        {
          "value": "w-full",
          "label": "Full width 全宽"
        },
        {
          "value": "container",
          "label": "Use container box 使用容器框"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment 文本对齐",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left 左对齐"
        },
        {
          "value": "center",
          "label": "Center 居中对齐"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "hide_current",
      "label": "Hide current page 隐藏当前页面",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_mb",
      "label": "Hide on mobile 隐藏在移动设备上",
      "default": false
    },
    {
      "type": "header",
      "content": "Animations 动画"
    },
    {
      "type": "select",
      "id": "animations",
      "label": "Visible in the view animation 在视图中可见动画",
      "default": "inherit",
      "options": [
        {"value": "inherit", "label": "Inherit global setting 继承全局设置"},
        {"value": "fade-in", "label": "Fade in 淡入"},
        {"value": "fade-in-up", "label": "Fade in up 淡入上"},
        {"value": "fade-in-left", "label": "Fade in left 淡入左"},
        {"value": "fade-in-right", "label": "Fade in right 淡入右"}
      ]
    }
  ],
  "presets": [
    {
      "name": "面包屑"
    }
  ]
}
{% endschema %}
