{%- liquid
  assign animation_effect = settings.animations
  assign animated = false
  if animation_effect != 'none'
    assign animated = true
    if section.settings.animations != 'inherit'
      assign animation_effect = section.settings.animations
    endif
  endif

  assign container = section.settings.container
  if container == 'w-full'
    assign container = 'container-full'
  endif

  assign classes = 'm-section m-collapsible-section'
  if section.settings.custom_class != blank
    assign classes = classes | append: ' ' | append: section.settings.custom_class
  endif
  assign classes = classes | append: ' m-gradient' | append: ' m-color-' | append: section.settings.color_scheme

  assign image = section.settings.image
  assign image_position = section.settings.image_position
-%}
<style>
  #m-collapsible--{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  }
  .m-collapsible__wrapper {
    display: grid;
  }
  .m-collapsible--image-right .m-collapsible__image {
    order: 1;
  }
  @media (min-width: 768px) {
    .m-collapsible__wrapper {
      grid-template-columns: 1fr 1fr;
      column-gap: var(--column-gap);
      align-items: center;
    }
  }
  @media (max-width: 767px) {
    .m-collapsible__image {
      margin-bottom: 24px;
    }
    .m-collapsible--image-right .m-collapsible__image {
      margin-bottom: 0;
      margin-top: 24px;
    }
  }
</style>
{% if section.blocks.size > 0 %}
  <section
    id="m-collapsible--{{ section.id }}"
    class="{{ classes }}"
    data-section-type="m-collapsible"
    data-section-id="{{ section.id }}"
  >
    <div class="{{ container }} m-section-my m-section-py">
      {% if image != blank %}
        <div
          class="m-collapsible__wrapper m-collapsible--image-{{ image_position }}"
          style="--column-gap: {{ section.settings.column_gap }}px;"
        >
      {% endif %}
      {% if image != blank %}
        {% liquid
          assign image_height = image.width | divided_by: image.aspect_ratio | round
          assign loading = 'lazy'
          assign fetchpriority = 'low'
          if section.index < 2 or section.settings.enable_preload_image
            assign loading = 'eager'
            assign fetchpriority = 'high'
          endif
        %}
        <div class="m-collapsible__image">
          {{
            image
            | image_url: width: 3840
            | image_tag:
              loading: loading,
              fetchpriority: fetchpriority,
              width: image.width,
              height: image_height,
              sizes: '100vw',
              widths: '375, 550, 750, 1100, 1500',
              alt: image.alt
            | escape
          }}
        </div>
      {% endif %}
      {% if image != blank %}<div class="m-collapsible__content-wrapper">{% endif %}
      {% render 'index-section-header', section_settings: section.settings %}
      <div class="m-collapsible-section__wrapper{% if template == 'product' %} m-product-collapsible{% endif %}{% if animated %} m-scroll-trigger animate--{{ animation_effect }}{% endif %}">
        {% for block in section.blocks %}
          <collapsible-tab
            class="m-collapsible no-js-hidden"
            data-block-id="collapsible-tab-{{ block.id }}"
            {% if block.settings.open %}
              open="true"
            {% endif %}
          >
            <h3 class="m-collapsible--button {{ block.settings.text_size }}" data-trigger>
              <span>{{ block.settings.header }}</span>
              <span class="m-collapsible--icon">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M13.5306 6.53073L8.5306 11.5307C8.46092 11.6007 8.37813 11.6561 8.28696 11.694C8.1958 11.7318 8.09806 11.7513 7.99935 11.7513C7.90064 11.7513 7.8029 11.7318 7.71173 11.694C7.62057 11.6561 7.53778 11.6007 7.4681 11.5307L2.4681 6.53073C2.3272 6.38984 2.24805 6.19874 2.24805 5.99948C2.24805 5.80023 2.3272 5.60913 2.4681 5.46823C2.60899 5.32734 2.80009 5.24818 2.99935 5.24818C3.19861 5.24818 3.3897 5.32734 3.5306 5.46823L7.99997 9.93761L12.4693 5.46761C12.6102 5.32671 12.8013 5.24756 13.0006 5.24756C13.1999 5.24756 13.391 5.32671 13.5318 5.46761C13.6727 5.60851 13.7519 5.7996 13.7519 5.99886C13.7519 6.19812 13.6727 6.38921 13.5318 6.53011L13.5306 6.53073Z" fill="currentColor"/>
                </svg>
              </span>
            </h3>
            <div class="m-collapsible--content" data-content hidden>
              <div class="m-collapsible--content__inner">
                {% case block.type %}
                  {% when 'item' %}
                    <div class="rte">
                      {{ block.settings.content }}
                      {{ block.settings.content_page.content }}
                    </div>
                  {% when 'liquid' %}
                    {{ block.settings.custom_liquid }}
                  {% else %}

                {% endcase %}
              </div>
            </div>
          </collapsible-tab>
        {% endfor %}
      </div>
      {% if image != blank %}</div>{% endif %}
      {% if image != blank %}</div>{% endif %}
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "Collapsible tabs 折叠标签",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "container",
      "label": "容器类型",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "固定宽度"
        },
        {
          "value": "container-fluid",
          "label": "拉伸宽度"
        },
        {
          "value": "container-narrow",
          "label": "窄宽度"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "颜色方案"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        {
          "value": "left",
          "label": "左"
        },
        {
          "value": "right",
          "label": "右"
        }
      ]
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "列间距",
      "min": 0,
      "max": 150,
      "step": 2,
      "default": 100
    },
    {
      "type": "header",
      "content": "Section header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "标题"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "标题大小",
      "default": "h3",
      "options": [
        {
          "label": "中等",
          "value": "h3"
        },
        {
          "label": "大",
          "value": "h2"
        }
      ]
    },
    {
      "type": "html",
      "id": "subheading",
      "label": "副标题"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "描述"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "文本对齐",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "左"
        },
        {
          "value": "center",
          "label": "中"
        }
      ]
    },
    {
      "type": "header",
      "content": "段落内边距"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "上内边距",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "下内边距",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "高级设置"
    },
    {
      "type": "checkbox",
      "id": "enable_preload_image",
      "label": "Enable preload image",
      "info": "If this section is visible when the page loads, enabling this setting can reduce LCP and may improve site speed scores."
    },
    {
      "type": "header",
      "content": "动画"
    },
    {
      "type": "select",
      "id": "animations",
      "label": "在视图中可见的动画",
      "default": "inherit",
      "options": [
        {
          "value": "inherit",
          "label": "继承全局设置",
        },
        {
          "value": "fade-in",
          "label": "淡入",
        },
        {
          "value": "fade-in-up",
          "label": "淡入向上",
        },
        {
          "value": "fade-in-left",
          "label": "淡入向左",
        },
        {
          "value": "fade-in-right",
          "label": "淡入向右",
        }
      ]
    },
    {
      "type": "header",
      "content": "自定义属性"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "自定义类"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Custom content 自定义内容",
      "settings": [
        {
          "type": "text",
          "id": "header",
          "label": "Collapsible tab 折叠标签",
          "default": "Collapsible tab heading"
        },
        {
          "type": "select",
          "id": "text_size",
          "label": "Text size 文本大小",
          "options": [
            {
              "value": "h5",
              "label": "小"
            },
            {
              "value": "h4",
              "label": "中等"
            },
            {
              "value": "h3",
              "label": "大"
            }
          ]
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Accordion content 折叠内容",
          "default": "<p>Shipping cost is based on weight. Just add products to your cart and use the Shipping Calculator to see the shipping price.</p><p>We want you to be 100% satisfied with your purchase. Items can be returned or exchanged within 30 days of delivery.</p>"
        },
        {
          "type": "page",
          "id": "content_page",
          "label": "Tab content from page 标签内容从页面"
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Default open 默认打开"
        }
      ]
    },
    {
      "type": "liquid",
      "name": "Custom liquid",
      "settings": [
        {
          "type": "text",
          "id": "header",
          "label": "Tab heading 标签标题",
          "default": "Tab heading"
        },
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "Custom liquid 自定义液体"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collapsible tabs 折叠标签",
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item"
        }
      ]
    }
  ]
}
{% endschema %}
