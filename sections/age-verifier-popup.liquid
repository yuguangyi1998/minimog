<link rel="stylesheet" href="{{ 'age-verifier.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'age-verifier.css' | asset_url | stylesheet_tag }}</noscript>

{%- liquid
  assign design_mode = section.settings.design_mode
  assign bg_image = section.settings.bg_image
  assign bg_blur = section.settings.bg_blur
  assign enable = section.settings.enable
-%}
<m-age-verifier-popup
  id="{{ section.id }}"
  class="m-age-verifier"
  data-section-id="{{ section.id }}"
  data-design-mode="{{ design_mode }}"
  data-enable="{{ enable }}"
>
  <div class="m-modal m-modal--wrapper">
    <div class="m-modal--content">
      <div class="m-modal--content-inner">
        {% if section.settings.bg_image != blank %}
          {% assign bg_height = bg_image.width | divided_by: bg_image.aspect_ratio | round %}
          <div class="m-age-verifier__bg{% if bg_blur %} m-age-verifier__bg-blur{% endif %}">
            {{
              bg_image
              | image_url: width: 2000
              | image_tag: loading: 'lazy', sizes: '100vw', width: bg_image.width, height: bg_height, alt: bg_image.alt
              | escape
            }}
          </div>
        {% endif %}
        <div class="m-age-verifier__wrapper m:text-center">
          <div class="m-age-verifier__content m-age-verifier__content-active" data-age-verifier-content>
            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'subheading' -%}
                  <h3 class="m-age-verifier__subtitle">{{ block.settings.subheading }}</h3>
                {%- when 'heading' -%}
                  <h2 class="m-age-verifier__title font-medium">{{ block.settings.heading }}</h2>
                {%- when 'text' -%}
                  <div class="rte m-age-verifier__text rte">{{ block.settings.text }}</div>
                {%- when 'image' -%}
                  {%- if block.settings.image != blank -%}
                    <div
                      {% if block.settings.use_custom_image_width %}
                        style="--image-width: {{ block.settings.custom_image_width }}px;"
                      {% endif %}
                      {{ block.shopify_attributes }}
                    >
                      {%- render 'responsive-image', image: block.settings.image, wrapper_class: 'm:blocks-radius' -%}
                    </div>
                  {%- else -%}
                    <div
                      class="m-image"
                      {% if block.settings.use_custom_image_width %}
                        style="--image-width: {{ block.settings.custom_image_width }}px; margin-left: auto; margin-right: auto;"
                      {% endif %}
                      {{ block.shopify_attributes }}
                    >
                      {{ 'image' | placeholder_svg_tag: 'placeholder-svg m:blocks-radius' }}
                    </div>
                  {%- endif -%}
                {%- else -%}
                  <div class="m-age-verifier__button-wrapper" {{ block.shopify_attributes }}>
                    {% if block.settings.decline_button != blank %}
                      <button class="m-button m-button--secondary" data-age-verifier-decline-button>
                        {{ block.settings.decline_button }}
                      </button>
                    {% endif %}
                    {% if block.settings.approve_button != blank %}
                      <button class="m-button m-button--primary" data-age-verifier-agree-button>
                        {{ block.settings.approve_button }}
                      </button>
                    {% endif %}
                  </div>
              {%- endcase -%}
            {%- endfor -%}
          </div>
          <div class="m-age-verifier__decline-content m:hidden" data-age-verifier-decline-content>
            {% if section.settings.decline_heading != blank %}
              <h2 class="m-age-verifier__title font-medium">{{ section.settings.decline_heading }}</h2>
            {% endif %}
            {% if section.settings.decline_content != blank %}
              <div class="rte m-age-verifier__text rte">{{ section.settings.decline_content }}</div>
            {% endif %}
            {% if section.settings.return_button != blank %}
              <button class="m-button m-button--secondary" data-age-verifier-return-button>
                {{ section.settings.return_button }}
              </button>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  </div>
</m-age-verifier-popup>
<script src="{{ 'age-verifier.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "年龄验证弹窗",
  "settings": [
    {
      "type": "header",
      "content": "设计模式"
    },
    {
      "type": "paragraph",
      "content": "开启设计模式后，弹窗将在自定义页面中始终显示，方便配置。正式上线前请务必关闭设计模式。"
    },
    {
      "type": "checkbox",
      "id": "design_mode",
      "label": "设计模式",
      "default": false
    },
    {
      "type": "header",
      "content": "基本设置"
    },
    {
      "type": "checkbox",
      "id": "enable",
      "label": "启用年龄验证",
      "default": false
    },
    {
      "type": "header",
      "content": "背景图片"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "背景图片",
      "info": "建议尺寸：2000 x 800px"
    },
    {
      "type": "checkbox",
      "id": "bg_blur",
      "label": "模糊背景图片",
      "default": false
    },
    {
      "type": "header",
      "content": "拒绝访问内容"
    },
    {
      "type": "paragraph",
      "content": "当用户不满足年龄要求时，将显示以下内容。"
    },
    {
      "type": "text",
      "id": "decline_heading",
      "label": "标题",
      "default": "您未达到访问年龄要求"
    },
    {
      "type": "richtext",
      "id": "decline_content",
      "label": "正文",
      "default": "<p>抱歉，本店铺的内容不适合未成年人浏览。请您成年后再来访问。</p>"
    },
    {
      "type": "text",
      "id": "return_button",
      "label": "返回按钮文字",
      "default": "我填写错误了，重新填写"
    }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "标题",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "标题",
          "default": "请确认您的年龄"
        }
      ]
    },
    {
      "type": "subheading",
      "name": "副标题",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "subheading",
          "label": "副标题",
          "default": "副标题文字"
        }
      ]
    },
    {
      "type": "text",
      "name": "文本",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "内容",
          "default": "<p>您是否已满18周岁？</p>"
        }
      ]
    },
    {
      "type": "image",
      "name": "图片",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "图片"
        },
        {
          "type": "checkbox",
          "id": "use_custom_image_width",
          "label": "使用自定义图片宽度",
          "default": true
        },
        {
          "type": "range",
          "id": "custom_image_width",
          "label": "自定义图片宽度（PX）",
          "unit": "PX",
          "min": 50,
          "max": 350,
          "step": 5,
          "default": 175
        }
      ]
    },
    {
      "type": "buttons",
      "name": "按钮",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "decline_button",
          "label": "拒绝按钮文字",
          "default": "不，我未满18岁"
        },
        {
          "type": "text",
          "id": "approve_button",
          "label": "确认按钮文字",
          "default": "是的，我已满18岁"
        }
      ]
    }
  ]
}
{% endschema %}
