{% liquid
  assign bg_color = section.settings.background_color
  assign has_bg = false
  unless bg_color == 'rgba(0,0,0,0)' or bg_color == blank
    assign has_bg = true
  endunless

  assign container = section.settings.container
  if container == 'w-full'
    assign container = 'container-full'
  endif
%}

<section
  id="m-app-section-{{ section.id }}"
  class="m-section m-app-section {{ section.settings.custom_class }}"
  {% if has_bg %}
    data-bg="{{ bg_color | color_to_hsl }}"
  {% endif %}
  style="background-color: {{ bg_color }};--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="{{ container }}{% if has_bg == false %} m-section-my{% else %} m-section-py{% endif %}">
    {% render 'index-section-header', section_settings: section.settings %}
    <div class="m-app-section__content">
      {% for block in section.blocks %}
        {% render block %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "应用容器",
  "settings": [
    {
      "type": "header",
      "content": "区块标题"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "标题"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "标题大小",
      "default": "h3",
      "options": [
        {
          "label": "中",
          "value": "h3"
        },
        {
          "label": "大",
          "value": "h2"
        }
      ]
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "副标题"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "文本对齐",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "左对齐"
        },
        {
          "value": "center",
          "label": "居中"
        }
      ]
    },
    {
      "type": "header",
      "content": "通用设置"
    },
    {
      "type": "select",
      "id": "container",
      "label": "容器类型",
      "default": "container",
      "options": [
        {
          "value": "container-fluid",
          "label": "默认"
        },
        {
          "value": "w-full",
          "label": "全宽"
        },
        {
          "value": "container",
          "label": "使用容器框"
        }
      ]
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "背景颜色"
    },
    {
      "type": "header",
      "content": "区块内边距"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "上内边距",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "下内边距",
      "default": 50,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "自定义属性"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "自定义 CSS 类名"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "应用容器"
    }
  ]
}
{% endschema %}
